# ── Production settings ───────────────────────────────────────────
# Copy to .env on the server:  cp deploy/env.production.example .env
# NEVER commit the real .env to GitHub.

# Your public address (a domain or subdomain whose DNS "A" record points to this server)
DOMAIN=sesizari.example.ro
APP_URL=https://sesizari.example.ro

# Database password – long, random, letters and digits only (it is used inside a URL).
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── First run (seed) ──────────────────────────────────────────────
# 1 = real launch: creates roles, workflow, departments and categories plus ONE
#     super admin (below). No demo accounts, no demo reports.
# Empty = demo server: all demo accounts and ~90 sample reports, like on localhost.
SEED_PRODUCTION=1
# The first administrator. Log in with these, then change the password.
SEED_ADMIN_EMAIL=admin@example.ro
# At least 12 characters. (In demo mode this is the password of every demo account.)
SEED_PASSWORD=change-me-too

# ── E-mail and SMS ────────────────────────────────────────────────
# mock = nothing is sent (citizens cannot receive verification e-mails!).
# webhook = POST to your mail/SMS relay – see README "Notifications".
EMAIL_PROVIDER=mock
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
SMS_PROVIDER=mock
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ── Address search ────────────────────────────────────────────────
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=contact@example.ro

# ── Sign in with Google (optional) ────────────────────────────────
# Redirect URI to register in Google Cloud: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_TELEMETRY_DISABLED=1
