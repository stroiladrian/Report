# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://civic:civic@localhost:5432/civicreport?schema=public"
# Used by `npm test` (integration tests). Never point this at production.
TEST_DATABASE_URL="postgresql://civic:civic@localhost:5432/civicreport_test?schema=public"

# ── Application ───────────────────────────────────────────────────
# Public base URL – used in e-mail links and CSRF origin checks.
APP_URL="http://localhost:3000"
# Where uploaded files are stored (outside /public; served via /api/files/:id after access checks).
UPLOAD_DIR="./storage/uploads"
# Set to 1 to force Secure cookies outside production (e.g. behind an HTTPS dev proxy).
COOKIE_SECURE=0

# ── Notification providers ────────────────────────────────────────
# mock  = nothing is sent; messages are stored and visible at /dev/mailbox (development).
# webhook = POST JSON {to, subject, text} / {to, text} to your relay (see src/server/providers).
EMAIL_PROVIDER=mock
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
SMS_PROVIDER=mock
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Dev mailbox (/dev/mailbox, /api/dev/mailbox): on by default outside production. 1 = force on, 0 = off.
DEV_MAILBOX=

# ── Geocoding ─────────────────────────────────────────────────────
# nominatim (OpenStreetMap, free, 1 req/s – cached) | mock (offline fictional addresses)
GEOCODER=nominatim
NOMINATIM_URL="https://nominatim.openstreetmap.org"
# Contact e-mail sent in the User-Agent, as required by the Nominatim usage policy.
GEOCODER_CONTACT="contact@demo-city.example"

# ── Seed ──────────────────────────────────────────────────────────
# Password for all demo accounts created by `npm run db:seed`.
SEED_PASSWORD="CivicDemo2026!"
SEED_REPORTS=90

# ── Misc ──────────────────────────────────────────────────────────
# RATE_LIMIT_DISABLED=1   # only for automated tests
# PRISMA_LOG=1            # log SQL queries
NEXT_TELEMETRY_DISABLED=1

# ── Sign in with Google (optional) ────────────────────────────────
# Leave empty to hide the "Continue with Google" button.
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add this Authorized redirect URI:  <your site>/api/auth/google/callback
#   e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
